<script setup lang="ts">
import { ref, computed, watch } from 'vue'
import { use{{pascalCase name}}Store } from '../stores/use{{pascalCase name}}Store'
import {{pascalCase name}}Table from '../components/{{pascalCase name}}Table.vue'
import AppPagination from '@/shared/components/AppPagination.vue'
import AppConfirmDialog from '@/shared/components/AppConfirmDialog.vue'
import Create{{pascalCase name}}Dialog from '../components/Create{{pascalCase name}}Dialog.vue'
import { usePagination } from '@/composables/usePagination'
import type { {{pascalCase name}} } from '../types'

const store = use{{pascalCase name}}Store()

const search = ref('')
const dialogOpen = ref(false)
const editingItem = ref<{{pascalCase name}} | null>(null)
const deleteDialogOpen = ref(false)
const deletingItem = ref<{{pascalCase name}} | null>(null)

const filtered = computed(() => {
  const q = search.value.toLowerCase()
  return store.items.filter(item => !q || item.name.toLowerCase().includes(q))
})

const { currentPage, totalPages, paginated, resetPage } = usePagination(filtered, 10)
watch(search, resetPage)

function openCreate() { editingItem.value = null; dialogOpen.value = true }
function openEdit(item: {{pascalCase name}}) { editingItem.value = item; dialogOpen.value = true }
function openDelete(item: {{pascalCase name}}) { deletingItem.value = item; deleteDialogOpen.value = true }

function handleSave(data: Partial<{{pascalCase name}}>) {
  // TODO: wire to store.create / store.update
  dialogOpen.value = false
}

function confirmDelete() {
  // TODO: wire to store.delete
  deleteDialogOpen.value = false
}
</script>

<template>
  <div class="flex flex-col gap-6">
    <!-- Header -->
    <div class="flex items-start justify-between">
      <div>
        <h1 class="text-2xl font-display font-semibold text-text-primary">{{pascalCase name}}</h1>
        <p class="text-sm text-text-secondary font-sans mt-0.5">Manage {{kebabCase name}} records</p>
      </div>
      <button
        class="flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-lg text-sm font-display font-medium hover:bg-primary-mid transition-colors"
        @click="openCreate"
      >
        Add {{pascalCase name}}
      </button>
    </div>

    <!-- Search -->
    <input
      v-model="search"
      type="text"
      placeholder="Search…"
      class="h-[42px] pl-4 pr-4 bg-white border border-border-dropdown rounded-lg text-xs font-display font-medium text-[#313144] placeholder:text-text-muted focus:outline-none focus:border-primary"
      style="border-width: 1.3px"
    />

    <!-- Table -->
    <{{pascalCase name}}Table
      :items="paginated"
      :loading="store.loading"
      @edit="openEdit"
      @delete="openDelete"
    />

    <!-- Pagination -->
    <AppPagination
      v-if="!store.loading && totalPages > 1"
      v-model:currentPage="currentPage"
      :total-pages="totalPages"
    />
  </div>

  <!-- Create / Edit dialog -->
  <Create{{pascalCase name}}Dialog
    :open="dialogOpen"
    :item="editingItem"
    @close="dialogOpen = false"
    @save="handleSave"
  />

  <!-- Delete confirm dialog -->
  <AppConfirmDialog
    :open="deleteDialogOpen"
    title="Delete {{pascalCase name}}"
    confirm-label="Delete"
    confirm-class="bg-danger text-white hover:opacity-80"
    @close="deleteDialogOpen = false"
    @confirm="confirmDelete"
  >
    <p class="text-sm text-text-secondary font-sans">
      Are you sure you want to delete
      <strong class="text-text-primary">\{{ deletingItem?.name }}</strong>?
      This action cannot be undone.
    </p>
  </AppConfirmDialog>
</template>
