# Copy to .env.local (gitignored) and adjust for your machine.

# Base URL of the ARCH API, including the /api prefix.
# Leave unset to use the staging default in src/app/config/env.ts.
# Must be HTTPS — the app itself is served over HTTPS and browsers block
# mixed-content requests to plain HTTP.
VITE_API_BASE_URL=https://arch-os-server.tailf7bd4c.ts.net/api
